<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Online_Alot" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Online_Alot" parent="Base.Theme.Online_Alot">
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_gradient_end</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen - fullscreen, premium look -->
    <style name="Theme.Online_Alot.Splash" parent="Theme.Online_Alot">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_gradient_end</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Home service detail sheet: section labels -->
    <style name="AdminHsDetailLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/splash_subtext</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearanceOverlay.Cutify.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Barber book card: photo matches top card corners -->
    <style name="ShapeAppearanceOverlay.Cutify.BarberCardPhotoTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Super Admin — glass UI: gold headers with soft glow (base required for SuperAdmin.* dot names) -->
    <style name="SuperAdmin" />

    <style name="SuperAdmin.SectionTitle">
        <item name="android:textColor">@color/super_section_gold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:gravity">center</item>
        <item name="android:shadowColor">#66FFD54F</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">10</item>
    </style>

    <style name="SuperAdmin.ScreenTitle">
        <item name="android:textColor">@color/super_section_gold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:gravity">center</item>
        <item name="android:shadowColor">#88FFD700</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">12</item>
    </style>
</resources>