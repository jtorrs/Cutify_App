<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/admin_hs_sheet_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/splash_accent"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cutify_dialog_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/feedback_dialog_badge"
                android:textAllCaps="true"
                android:textColor="@color/splash_accent_light"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:ignore="SmallSp" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/splash_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Rate your visit" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/super_invite_branding_cutify"
                android:textColor="@color/welcome_teal_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="44dp"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_hs_gradient_accent_line" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/feedback_subtitle"
            android:textColor="@color/splash_subtext"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/star_1"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="★"
                android:textColor="@color/splash_subtext"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/star_2"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="★"
                android:textColor="@color/splash_subtext"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/star_3"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="★"
                android:textColor="@color/splash_subtext"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/star_4"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="★"
                android:textColor="@color/splash_subtext"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/star_5"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="★"
                android:textColor="@color/splash_subtext"
                android:textSize="32sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/rate_btn"
            android:textAllCaps="false"
            android:textColor="@color/splash_background"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/splash_accent"
            app:cornerRadius="12dp"
            app:elevation="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_report"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/report_btn"
            android:textAllCaps="false"
            android:textColor="@color/report_red"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="@color/report_red"
            app:strokeWidth="1.5dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
