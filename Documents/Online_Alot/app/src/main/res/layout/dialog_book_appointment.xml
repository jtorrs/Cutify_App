<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/admin_hs_sheet_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/welcome_teal"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cutify_dialog_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/book_dialog_badge"
                    android:textAllCaps="true"
                    android:textColor="@color/welcome_teal_light"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:ignore="SmallSp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/book_confirm"
                    android:textColor="@color/splash_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_hs_gradient_accent_line" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_book_appointment_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/admin_hs_close"
                android:padding="8dp"
                android:src="@drawable/ic_close_24" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/book_dialog_message"
            android:textColor="@color/splash_subtext"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_book_appointment_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_edittext_dark"
            android:gravity="center_vertical"
            android:hint="@string/enter_name_hint"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="14dp"
            android:textColor="@color/splash_text"
            android:textColorHint="@color/splash_subtext"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/et_book_appointment_service"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_edittext_dark"
            android:gravity="center_vertical"
            android:hint="@string/booking_service_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="2"
            android:paddingHorizontal="14dp"
            android:textColor="@color/splash_text"
            android:textColorHint="@color/splash_subtext"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_book_appointment_cancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:text="@string/no"
                android:textAllCaps="false"
                android:textColor="@color/splash_subtext"
                app:cornerRadius="10dp"
                app:strokeColor="@color/admin_hs_section_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_book_appointment_confirm"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:text="@string/book_btn"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/welcome_teal"
                app:cornerRadius="10dp"
                app:elevation="2dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
