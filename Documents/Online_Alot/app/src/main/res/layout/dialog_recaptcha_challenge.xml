<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_stat_card"
    android:paddingHorizontal="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/recaptcha_verify_title"
        android:textColor="@color/welcome_teal_light"
        android:textSize="17sp"
        android:letterSpacing="0.02"
        android:textStyle="bold" />

    <WebView
        android:id="@+id/web_recap_dialog"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_premium" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_recap_dialog_cancel"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/recaptcha_cancel"
        android:textAllCaps="false"
        android:textColor="@color/splash_subtext"
        app:strokeColor="@color/admin_hs_section_stroke"
        app:strokeWidth="1.2dp" />

</LinearLayout>
