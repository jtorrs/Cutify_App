<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_user_side_barber_pole"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.22"
            android:text="@string/super_invite_branding_cutify"
            android:textColor="@color/welcome_teal_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hs_gradient_accent_line" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/admin_hs_sheet_bg"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/welcome_teal"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cutify_dialog_header"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.14"
                        android:text="@string/user_home_service_badge"
                        android:textAllCaps="true"
                        android:textColor="@color/welcome_teal_light"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:ignore="SmallSp" />

                    <View
                        android:layout_width="36dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_hs_gradient_accent_line" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:letterSpacing="0.02"
                        android:text="@string/home_service_title"
                        android:textColor="@color/splash_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/user_home_service_header_sub"
                        android:textColor="@color/splash_subtext"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="14dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:text="@string/nav_home_service"
                android:textColor="@color/splash_accent_light"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/user_card_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="5dp"
                app:strokeColor="@color/welcome_teal"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/home_service_form_intro"
                        android:textColor="@color/splash_subtext"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/et_hs_name"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_input_premium"
                        android:hint="@string/home_service_name_hint"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/splash_text"
                        android:textColorHint="@color/splash_subtext"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/et_hs_service"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_premium"
                        android:hint="@string/home_service_service_hint"
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/splash_text"
                        android:textColorHint="@color/splash_subtext"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/et_hs_age"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_premium"
                        android:hint="@string/home_service_age_hint"
                        android:inputType="number"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/splash_text"
                        android:textColorHint="@color/splash_subtext"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/et_hs_phone"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_premium"
                        android:hint="@string/home_service_phone_hint"
                        android:inputType="phone"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/splash_text"
                        android:textColorHint="@color/splash_subtext"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/et_hs_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_premium"
                        android:gravity="top"
                        android:hint="@string/home_service_address_hint"
                        android:inputType="textPostalAddress|textMultiLine"
                        android:minHeight="72dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:textColor="@color/splash_text"
                        android:textColorHint="@color/splash_subtext"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/home_service_preferred_time_label"
                        android:textColor="@color/splash_accent_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_hs_pick_datetime"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/home_service_pick_datetime"
                        android:textColor="@color/welcome_teal_light"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/welcome_teal"
                        app:strokeWidth="1.5dp" />

                    <TextView
                        android:id="@+id/tv_hs_preferred_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/home_service_preferred_time_none"
                        android:textColor="@color/splash_subtext"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/user_card_bg_soft"
                app:cardCornerRadius="20dp"
                app:cardElevation="5dp"
                app:strokeColor="@color/splash_accent"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_turn_on_location"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/home_service_turn_on_location"
                        android:textAllCaps="false"
                        android:textColor="@color/splash_background"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/splash_accent"
                        app:cornerRadius="14dp"
                        app:elevation="2dp"
                        app:rippleColor="@color/splash_accent_light" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_location_settings"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/home_service_open_settings"
                        android:textAllCaps="false"
                        android:textColor="@color/welcome_teal_light"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/welcome_teal"
                        app:strokeWidth="1.5dp" />

                    <TextView
                        android:id="@+id/tv_hs_location_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="@color/splash_subtext"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_home_pin_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/home_service_pin_need_gps"
                        android:textColor="@color/welcome_teal_light"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/home_service_map_hint"
                        android:textColor="@color/splash_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <WebView
                        android:id="@+id/wv_map"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_premium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_map_location"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/home_service_save_map_location"
                        android:textAllCaps="false"
                        android:textColor="@color/welcome_teal_light"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/welcome_teal"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:text="@string/home_service_choose_barber"
                android:textColor="@color/splash_accent_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_barbers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_user_bottom_nav" />
</LinearLayout>
