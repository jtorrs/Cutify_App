<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_super_admin_root"
    android:orientation="vertical">

    <!-- App bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/SuperAdmin.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/super_admin_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/super_admin_subtitle"
                android:textColor="@color/splash_subtext"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="✦"
                android:textColor="@color/role_super_gold"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_sign_out"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_sign_out_icon"
            android:contentDescription="@string/admin_sign_out"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_sign_out"
            app:tint="@color/splash_accent_light" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Manage Staff tab -->
        <ScrollView
            android:id="@+id/scroll_staff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <TextView
                    style="@style/SuperAdmin.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/super_manage_staff_header" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/super_glass_fill"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/super_glass_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/super_manage_staff_list_hint"
                            android:textColor="@color/splash_subtext"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/layout_manage_staff_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tv_manage_staff_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="@string/super_staff_list_empty"
                            android:textColor="@color/role_super_gold_dim"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_delete_staff"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="16dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/super_delete_staff_action"
                            android:textAllCaps="false"
                            android:textColor="@color/report_red"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/report_red"
                            app:strokeWidth="1.5dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SuperAdmin.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/security_super_2fa_label" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/super_glass_fill_deep"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/super_glass_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_super_2fa_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.2"
                            android:textColor="@color/splash_text"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_view_audit_log"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/security_view_audit"
                            android:textAllCaps="false"
                            android:textColor="@color/welcome_teal_light"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/welcome_teal"
                            app:strokeWidth="1.5dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SuperAdmin.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/super_invite_section_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:letterSpacing="0.2"
                    android:text="@string/super_invite_branding_cutify"
                    android:textColor="@color/welcome_teal_light"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/super_glass_fill_soft"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/super_glass_border_soft"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/section_invite_admin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="18dp">

                        <View
                            android:layout_width="48dp"
                            android:layout_height="3dp"
                            android:background="@drawable/bg_hs_gradient_accent_line" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/super_invite_email_hint"
                            android:textColor="@color/splash_subtext"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_invite_admin_email"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_edittext_dark"
                            android:gravity="center_vertical"
                            android:hint="@string/super_invite_email_placeholder"
                            android:inputType="textEmailAddress"
                            android:paddingHorizontal="16dp"
                            android:textColor="@color/splash_text"
                            android:textColorHint="@color/splash_subtext"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_send_admin_invite"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="14dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/super_send_invitation"
                            android:textAllCaps="false"
                            android:textColor="@color/splash_background"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/splash_accent"
                            app:cornerRadius="14dp"
                            app:elevation="3dp"
                            app:rippleColor="@color/splash_accent_light" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_invite_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/welcome_teal_light"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Statistics tab -->
        <ScrollView
            android:id="@+id/scroll_overview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <TextView
                    style="@style/SuperAdmin.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/super_today_overview_title" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/super_glass_fill"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/super_glass_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="●"
                            android:textColor="@color/super_neon_green"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_on_duty_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/splash_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SuperAdmin.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/super_per_barber_today" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/super_glass_fill"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/super_glass_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/layout_today_barbers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="14dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SuperAdmin.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/statistics_label" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/super_glass_fill_deep"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/super_glass_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="5dp">

                        <TextView
                            android:id="@+id/tab_day"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_super_period_tab_active"
                            android:gravity="center"
                            android:text="@string/tab_day"
                            android:textColor="@color/splash_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tab_week"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_super_period_tab_idle"
                            android:gravity="center"
                            android:text="@string/tab_week"
                            android:textColor="@color/splash_subtext"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tab_month"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_super_period_tab_idle"
                            android:gravity="center"
                            android:text="@string/tab_month"
                            android:textColor="@color/splash_subtext"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tab_year"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_super_period_tab_idle"
                            android:gravity="center"
                            android:text="@string/tab_year"
                            android:textColor="@color/splash_subtext"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_export_super_pdf"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/pdf_export_super_report"
                        android:textAllCaps="false"
                        android:textColor="@color/splash_accent_light"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/super_glass_border"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reset_period_records"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/super_reset_period_records"
                        android:textAllCaps="false"
                        android:textColor="@color/splash_accent_light"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/super_glass_border"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/super_glass_fill"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/super_glass_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/layout_stat_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="22dp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_peak_dashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/super_glass_fill_deep"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/super_glass_border"
                    app:strokeWidth="1dp">

                    <include layout="@layout/layout_peak_hours_dashboard" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SuperAdmin.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/reports_title" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    app:cardBackgroundColor="@color/super_glass_fill_deep"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/super_glass_report_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/layout_reports"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="16dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_super_glass_bottom_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/nav_super_stats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_super_stats"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_stats"
                app:tint="@color/splash_accent" />

            <TextView
                android:id="@+id/tv_nav_super_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/super_nav_statistics"
                android:textColor="@color/splash_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_super_staff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_super_staff"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_profile"
                app:tint="#6B7280" />

            <TextView
                android:id="@+id/tv_nav_super_staff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/super_nav_manage_staff"
                android:textColor="#6B7280"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
