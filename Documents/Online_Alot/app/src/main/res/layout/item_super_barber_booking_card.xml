<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="158dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/layout_barber_booking_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_super_booking_card_blue"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tv_barber_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:letterSpacing="0.02"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Juan" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="#40FFFFFF" />

        <TextView
            android:id="@+id/tv_booking_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:textColor="@color/white"
            android:textSize="38sp"
            android:textStyle="bold"
            tools:text="25" />

        <TextView
            android:id="@+id/tv_home_service"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.95"
            android:gravity="center_horizontal"
            android:textColor="@color/white"
            android:textSize="12sp"
            tools:text="Home Service: 8" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
