<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/admin_hs_sheet_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/welcome_teal"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cutify_dialog_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/notif_permission_badge"
                android:textAllCaps="true"
                android:textColor="@color/welcome_teal_light"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:ignore="SmallSp" />

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_notification_bell"
                app:tint="@color/welcome_teal_light" />

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hs_gradient_accent_line" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_notif_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/splash_text"
            android:textSize="15sp"
            tools:text="Allow Cutify to send notifications?" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_allow"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="18dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/notif_allow"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/welcome_teal"
            app:cornerRadius="12dp"
            app:elevation="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dont_allow"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:text="@string/notif_dont_allow"
            android:textAllCaps="false"
            android:textColor="@color/splash_subtext"
            android:textSize="14sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
