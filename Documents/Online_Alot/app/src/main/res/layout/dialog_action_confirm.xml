<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/admin_hs_sheet_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/welcome_teal"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cutify_dialog_header"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_action_confirm_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/discover_screen_badge"
                android:textAllCaps="true"
                android:textColor="@color/welcome_teal_light"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:ignore="SmallSp" />

            <TextView
                android:id="@+id/tv_action_confirm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/splash_text"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Confirm action" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hs_gradient_accent_line" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_action_confirm_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hs_detail_section"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp"
            android:textColor="@color/splash_accent_light"
            android:textSize="13sp"
            tools:text="Are you sure you want to continue?" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_confirm_no"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/no"
                android:textAllCaps="false"
                android:textColor="@color/splash_accent_light"
                app:cornerRadius="10dp"
                app:strokeColor="@color/splash_accent"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_confirm_yes"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/yes"
                android:textAllCaps="false"
                android:textColor="@color/book_now_label"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/splash_accent"
                app:cornerRadius="10dp"
                app:elevation="2dp"
                app:rippleColor="@color/splash_accent_light" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
